{
  "name": "Python & Terraform Dev Environment",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest",
      "terragrunt": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "hashicorp.terraform",
        "anton-kurtsson.elementals-tflint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terraform.languageServer.enable": true
      }
    }
  }
}
